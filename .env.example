# Copy this file to .env and adjust if you like — these defaults are fine for local dev.
# Nothing in here is a real secret; it only ever talks to containers on your own machine.

POSTGRES_USER=sd_user
POSTGRES_PASSWORD=sd_password
POSTGRES_DB=service_desk
# Deliberately not 5432 - the sibling ai-auto project already uses that on the host.
POSTGRES_HOST_PORT=5433

# Deliberately not 5678 - the sibling ai-auto project already uses that.
N8N_HOST_PORT=5679

RABBITMQ_USER=sd_user
RABBITMQ_PASSWORD=sd_password

# Ollama runs on the host, not in Compose.
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama

# --- Telegram (optional) --------------------------------------------------
# Leave TELEGRAM_BOT_TOKEN empty and the bot is simply off: nothing polls, and
# approval notifications go to n8n only.
#
# To switch it on:
#   1. Message @BotFather on Telegram, /newbot, paste the token below.
#   2. Start the stack, message your bot, then read the chat id out of
#      `docker compose logs telegram-bot` - it logs the id of anyone it
#      refuses, which is how you find your own.
#   3. Put that id in TELEGRAM_ALLOWED_CHAT_IDS and restart the bot.
#
# The allowlist is the only thing standing between a stranger who found the
# bot and a stranger who can resolve your tickets. Empty means nobody.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
