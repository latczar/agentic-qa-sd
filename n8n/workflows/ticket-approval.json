{
  "id": "ticketapproval001",
  "active": false,
  "name": "Ticket approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ticket-approval",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-approval",
      "name": "Approval needed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 0],
      "webhookId": "ticket-approval"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.priority }}",
              "rightValue": "CRITICAL",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "branch-priority",
      "name": "Is it CRITICAL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/tickets/{{ $json.body.ticket_id }}/comments",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "=🚨 Paged on-call. CRITICAL ticket needs approval now.\nReason: {{ $json.body.reason }}\nProposed: {{ $json.body.recommended_resolution }}"
            }
          ]
        },
        "options": {}
      },
      "id": "page-oncall",
      "name": "Page on-call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/tickets/{{ $json.body.ticket_id }}/comments",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "=Queued for agent review ({{ $json.body.priority }}, confidence {{ $json.body.confidence }}).\nReason: {{ $json.body.reason }}\nProposed: {{ $json.body.recommended_resolution }}"
            }
          ]
        },
        "options": {}
      },
      "id": "queue-review",
      "name": "Queue for review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, 120]
    }
  ],
  "connections": {
    "Approval needed": {
      "main": [[{ "node": "Is it CRITICAL?", "type": "main", "index": 0 }]]
    },
    "Is it CRITICAL?": {
      "main": [
        [{ "node": "Page on-call", "type": "main", "index": 0 }],
        [{ "node": "Queue for review", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "errorhandler001" },
  "pinData": {}
}
